{
  "name": "harz-karreg-desktop",
  "version": "0.3.4",
  "private": true,
  "description": "Plateforme desktop de planification transport HARZ KARREG",
  "author": "HARZ KARREG",
  "license": "MIT",
  "main": "electron/main/main.js",
  "scripts": {
    "dev": "electron .",
    "start": "electron .",
    "test": "node --test",
    "check": "node scripts/check-js.js",
    "pack:win": "electron-builder --win --dir",
    "dist:win": "electron-builder --win nsis",
    "release:win": "electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "com.harzkarreg.planner",
    "productName": "HARZ KARREG",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "Harz-Karreg",
        "repo": "harz_truck_planner-releases",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "harz-karreg-webapp/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "HARZ-KARREG-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HARZ KARREG"
    }
  }
}
