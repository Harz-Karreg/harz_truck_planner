# Copiez ce fichier vers /opt/harzkarreg/config/harzkarreg.env.
# Aucune valeur sensible ne doit être commitée.
HK_VERSION=0.3.5
HK_BIND_ADDRESS=0.0.0.0
HK_PUBLIC_PORT=8080

# Réservé au futur backend Rust ; sans effet pendant la phase web statique.
HK_DATA_DIR=/opt/harzkarreg/data
HK_API_PORT=8081
HK_LOG_LEVEL=info
HK_DEVICE_MODE=companion
HK_POLL_INTERVAL_SECONDS=30
HK_CLOUD_SYNC_ENABLED=false
